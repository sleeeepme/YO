# Public design preview works without environment variables.
NEXT_PUBLIC_APP_URL=
# Enable only after SQL migration and LiveKit webhook configuration + acceptance tests.
YO_VOICE_ENABLED=false
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Server-only: random >=32 characters. Rotating invalidates guest sessions/invites.
YO_SESSION_SECRET=
# Reserved for future Supabase Auth / SNS login, currently not read.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
